# Streamlit Secrets Configuration Template
# Copy this file as .streamlit/secrets.toml and fill in your actual values
# This file should NOT be committed to GitHub

# GitHub credentials (optional, for data loading)
GITHUB_USERNAME = "kananashish"
DATA_REPO_NAME = "heart-data"

# Database configuration (if using external database)
# DB_HOST = "your-db-host"
# DB_USER = "your-db-user"
# DB_PASSWORD = "your-db-password"
# DB_NAME = "heart_failure_db"

# Authentication settings
# SECRET_KEY = "your-secret-key-for-sessions"

# Optional: API keys or other sensitive credentials
# API_KEY = "your-api-key"
